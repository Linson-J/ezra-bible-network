# Copy to .env (which is gitignored) and adjust. Bundled into the app at build time.

# HLS (.m3u8) URL the app plays. RTMP ingest URLs cannot be played in-app.
STREAM_URL=https://your-server/live/ezra/index.m3u8
# Optional second HLS URL tried when STREAM_URL fails.
STREAM_BACKUP_URL=
# local = read assets/data/*.json, api = call API_BASE_URL
DATA_SOURCE=local
# Required when DATA_SOURCE=api, e.g. https://api.ezrabiblenetwork.com
API_BASE_URL=
# Default daily-verse notification time (24h, device timezone). Users can change it in Settings.
DAILY_VERSE_HOUR=6
DAILY_VERSE_MINUTE=30

# Optional. Long-lived Instagram API token (Instagram API with Instagram Login,
# scope instagram_business_basic) to show recent posts on the More tab.
# Leave empty to show a "Follow on Instagram" card instead.
INSTAGRAM_ACCESS_TOKEN=
